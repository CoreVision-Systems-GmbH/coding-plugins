{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Standard: check (alle Prüfungen, vor jedem Commit)",
      "type": "shell",
      "command": "composer check",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Standard: Kennzahlen je Funktion",
      "type": "shell",
      "command": "bash scripts/komplexitaet-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: Konfiguration prüfen",
      "type": "shell",
      "command": "bash scripts/konfig-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: Lizenzen prüfen",
      "type": "shell",
      "command": "bash scripts/lizenzen-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: Rauchtest (Trockenlauf, zeigt die Liste)",
      "type": "shell",
      "command": "bash deploy/smoke.sh --dry-run",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: Dev-Instanz starten (auf dem Dev-Server)",
      "type": "shell",
      "command": "bash deploy/dev.sh up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: PR-Text prüfen (wie die CI)",
      "type": "shell",
      "command": "gh pr view --json body -q .body | bash scripts/pr-text-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.bat]
end_of_line = crlf

# Theme und Mu-Plugins folgen den WordPress-Coding-Standards: Tabs (composer lint).
[web/app/**.{php,html,css,json}]
indent_style = tab

# Vorlage für die Umgebungsdatei. Auf dem Server als .env ablegen und die Platzhalter
# ersetzen. Die .env selbst gehört nie ins Repository; die Werte kommen aus dem
# KeePassXC-Tresor. compose.yaml reicht sie an app, cron und db weiter.

# --- Ausgelieferte Fassung -------------------------------------------------
# Der Abbild-Kennsatz dieser Instanz: compose.yaml zieht genau
# {{IMAGE}}:$APP_VERSION. Ohne den Wert startet der Verbund nicht — das ist
# Absicht, sonst liefe irgendein Stand.
#
# Geändert wird er nur über deploy/update.sh <tag>; das Skript sichert vorher,
# trägt den Wert ein und prüft danach, dass wirklich diese Fassung läuft. Der
# Rückweg ist derselbe Aufruf mit dem alten Tag.
APP_VERSION=0.1.0

# --- Site ------------------------------------------------------------------
# production | development. Alles außer production zeigt Fehler an und sperrt
# Suchmaschinen aus (config/environments/, Mu-Plugin firmenstandard).
WP_ENV=production
# Die öffentliche Adresse ohne Schrägstrich am Ende. WordPress liegt darunter in /wp
# (Anmeldung: WP_HOME/wp/wp-login.php). Schlägt die Werte in der Datenbank — ein Umzug
# heißt: hier ändern, danach `wp search-replace` für absolute Adressen in Inhalten.
WP_HOME=https://{{NAME}}.invalid
# Für die Erstinstallation (deploy/install.sh): Titel, Admin-Konto und dessen Mail.
# Kein Benutzer namens "admin" — das ist der erste Versuch jedes Angreifers.
WP_SITE_TITLE="{{NAME}}"
WP_ADMIN_USER=
WP_ADMIN_EMAIL=

# --- Datenbank (MariaDB, Dienst `db` aus compose.yaml) ---------------------
DB_HOST=db
DB_NAME={{NAME_SNAKE}}
DB_USER={{NAME_SNAKE}}
# Einmal je Instanz erzeugen und in den KeePassXC-Tresor legen.
DB_PASSWORD=
DB_PREFIX=wp_

# --- Schlüssel und Salts ---------------------------------------------------
# Acht Zufallswerte, je Instanz einmal erzeugt (z. B. `openssl rand -base64 48`, je
# Zeile einer). Sie signieren Cookies und Nonces; ändern meldet alle Nutzer ab.
# Nie ins Repository, nie ins Abbild.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

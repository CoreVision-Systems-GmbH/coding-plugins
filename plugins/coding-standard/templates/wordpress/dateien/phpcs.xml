<?xml version="1.0"?>
<ruleset name="{{NAME}}">
    <description>WordPress-Coding-Standards für Theme und Mu-Plugins; PSR-12 für Konfiguration und Prüfskripte.</description>

    <file>web/app/mu-plugins</file>
    <file>web/app/themes/site</file>
    <file>config</file>
    <file>tests</file>

    <!-- Nur PHP: Block-Vorlagen (HTML) und theme.json prüft WordPress beim Laden. -->
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Eigener WordPress-Code im Stil von WordPress: Tabs, Yoda, Escaping, Dokumentation. -->
    <rule ref="WordPress">
        <exclude-pattern>*/config/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="site"/>
                <element value="firmenstandard"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="site"/>
            </property>
        </properties>
    </rule>
    <config name="minimum_wp_version" value="7.0"/>

    <!-- Konfiguration (nach dem Muster von Bedrock) und Prüfskripte folgen PSR-12. -->
    <rule ref="PSR12">
        <include-pattern>*/config/*</include-pattern>
        <include-pattern>*/tests/*</include-pattern>
    </rule>
    <!-- Eine Konfigurationsdatei definiert Konstanten UND wirkt — das ist ihr Zweck. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/config/*</exclude-pattern>
    </rule>
</ruleset>

# Webserver des Abbilds: liefert das gebaute HTML aus /srv.
#
# TLS und die Zuordnung der Hostnamen macht der Edge-Caddy des Servers; hier
# wird bewusst nur einfaches HTTP auf 8080 gesprochen. Deshalb `auto_https off`
# — sonst versuchte dieser Caddy, eigene Zertifikate zu besorgen. `admin off`,
# weil niemand die Konfiguration zur Laufzeit ändern soll.
#
# {$APP_IMAGE_VERSION} ist ein Umgebungs-Platzhalter, den Caddy vor dem Parsen
# einsetzt — der Wert kommt aus dem Dockerfile.

{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Kein Server-Banner, keine MIME-Rätselei im Browser, sparsamer Referrer.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Der Zustandsbericht antwortet direkt aus dem Caddy, ohne Datei. Der
	# Compose-Healthcheck und deploy/update.sh zeigen hierher und vergleichen
	# die Fassung. Der Pfad bleibt ohne Protokollierung, damit die Überwachung
	# das Zugriffsprotokoll nicht flutet.
	@health path /healthz
	log_skip @health
	handle @health {
		header Content-Type application/json
		respond `{"status":"ok","version":"{$APP_IMAGE_VERSION}"}` 200
	}

	# Astro hängt an gebündelte Dateien einen Inhalts-Hash; sie ändern sich
	# nie und dürfen ein Jahr im Browser bleiben.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# Verzeichnisse ohne Schrägstrich werden umgeleitet (/seite -> /seite/);
	# astro.config.mjs hält den Dev-Server mit trailingSlash: always darauf.
	handle {
		file_server
	}

	# Die von Astro gebaute Fehlerseite; file_server behält in handle_errors
	# den Fehlerstatus, die Antwort bleibt also ein 404.
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	log {
		output stderr
		format json
	}
}

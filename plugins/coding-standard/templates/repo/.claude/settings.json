{
  "extraKnownMarketplaces": {
    "corevision": {
      "source": {
        "source": "github",
        "repo": "CoreVision-Systems-GmbH/coding-plugins"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "coding-standard@corevision": true
  },
  "permissions": {
    "allow": [
      "Bash(composer check:*)",
      "Bash(composer test:*)",
      "Bash(composer lint:*)",
      "Bash(composer analyse:*)",
      "Bash(composer audit:*)",
      "Bash(composer ci:check:*)",
      "Bash(composer types:check:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(vendor/bin/phpstan:*)",
      "Bash(vendor/bin/pest:*)",
      "Bash(php -l:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan migrate:status:*)",
      "Bash(php artisan test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run types:check:*)",
      "Bash(npm test:*)",
      "Bash(npm audit:*)",
      "Bash(make check:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(pip-audit:*)",
      "Bash(shellcheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.dev)",
      "Read(.env.development)",
      "Read(.env.test)",
      "Read(.env.testing)",
      "Read(.env.backup)",
      "Read(.env.bak)",
      "Read(.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(**/*.kdbx)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.dump)",
      "Read(**/*.sql.gz)",
      "Bash(git diff --no-index:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:refresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(alembic downgrade base:*)",
      "Bash(wp db reset:*)",
      "Bash(wp db drop:*)",
      "Bash(wp db clean:*)"
    ]
  }
}

# Vorlage für die Umgebungsdatei. Auf dem Server als .env ablegen und die
# Platzhalter ersetzen. Die .env selbst gehört nie ins Repository; die Werte
# kommen aus dem KeePassXC-Tresor.

# --- Ausgelieferte Fassung -------------------------------------------------
# Der Abbild-Kennsatz dieser Instanz: compose.yaml zieht genau
# {{IMAGE}}:$APP_VERSION. Ohne den Wert startet der Verbund nicht — das ist
# Absicht, sonst liefe irgendein Stand.
#
# Geändert wird er nur über deploy/update.sh <tag>; das Skript sichert
# vorher, trägt den Wert ein und prüft danach, dass wirklich diese Fassung
# läuft. Der Rückweg ist derselbe Aufruf mit dem alten Tag.
APP_VERSION=0.1.0

APP_NAME="{{NAME}}"
APP_ENV=production
# Einmal je Instanz erzeugen (php artisan key:generate --show) und in den
# KeePassXC-Tresor legen. Nie ins Repository, nie ins Abbild.
APP_KEY=
APP_DEBUG=false
APP_URL=https://beispiel.invalid

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT
# Nie hart UTC: Prüfungen wie "nicht in der Zukunft" müssen dieselbe Uhr
# lesen wie das Formular im Browser.
APP_TIMEZONE=Europe/Vienna

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Datenbank -------------------------------------------------------------
# Der Host ist der Dienstname aus compose.yaml, nicht 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE={{NAME_SNAKE}}
DB_USERNAME={{NAME_SNAKE}}
# Einmal je Instanz erzeugen und in den KeePassXC-Tresor legen.
DB_PASSWORD=

# --- Sitzung, Warteschlange, Zwischenspeicher ------------------------------
# Alles über die Datenbank: Ein eigener Zwischenspeicherdienst wäre ein
# zusätzlicher Betriebsposten; er kommt erst, wenn die Last ihn verlangt.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Hinter dem Edge-Caddy läuft alles über https.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Vertrauenswürdige Gegenstellen ---------------------------------------
# Der Edge-Caddy des Servers terminiert TLS und reicht die ursprüngliche
# Anfrage per X-Forwarded-* weiter. Ohne diese Angabe erzeugt Laravel
# http-Adressen hinter https, und Anmeldung und Weiterleitungen laufen ins Leere.
TRUSTED_PROXIES=*

# --- E-Mail ----------------------------------------------------------------
# Vorerst nur ins Protokoll: Solange kein Versandweg feststeht, wäre ein
# stiller Fehlversand schlimmer als gar kein Versand.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="{{NAME}}@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

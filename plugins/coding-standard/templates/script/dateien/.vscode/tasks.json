{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Standard: check (alle Prüfungen, vor jedem Commit)",
      "type": "shell",
      "command": "bash scripts/check.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Standard: Kennzahlen je Funktion",
      "type": "shell",
      "command": "bash scripts/komplexitaet-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Standard: PR-Text prüfen (wie die CI)",
      "type": "shell",
      "command": "gh pr view --json body -q .body | bash scripts/pr-text-pruefen.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
